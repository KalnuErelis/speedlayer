{
  "name": "speedlayer",
  "version": "0.1.0-alpha.0",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Jaunius Kadunas"
  },
  "contributors": [
    {
      "name": "WofWca",
      "email": "wofwca@protonmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KalnuErelis/speedlayer.git"
  },
  "bugs": {
    "url": "https://github.com/KalnuErelis/speedlayer/issues"
  },
  "homepage": "https://github.com/KalnuErelis/speedlayer#readme",
  "scripts": {
    "_abstract-build": "yarn lint && NODE_ENV=production webpack --mode=production",
    "build:gecko": "yarn run _abstract-build --env browser=gecko",
    "build:popup:chromium": "NODE_ENV=production vite build --config vite.popup.config.ts",
    "build:chromium": "sh -c 'yarn run _abstract-build --env browser=chromium --env noreport \"$@\" && yarn run build:popup:chromium' --",
    "build:chromium:report": "sh -c 'yarn run _abstract-build --env browser=chromium \"$@\" && yarn run build:popup:chromium' --",
    "_abstract-build-and-package": "if [ \"$BROWSER\" = \"chromium\" ]; then yarn run build:chromium; else yarn run build:$BROWSER -- --env noreport; fi && cd dist-$BROWSER && rm -f ../dist-$BROWSER.zip && zip -r ../dist-$BROWSER.zip .",
    "build-and-package:gecko": "BROWSER=gecko yarn run _abstract-build-and-package",
    "build-and-package:chromium": "BROWSER=chromium yarn run _abstract-build-and-package",
    "build-and-package:all": "rm -f dist-*.zip && yarn run build-and-package:gecko & yarn run build-and-package:chromium",
    "_abstract-serve": "webpack --mode=development --watch",
    "serve:gecko": "yarn run _abstract-serve --env browser=gecko",
    "serve:chromium": "yarn run _abstract-serve --env browser=chromium & yarn run serve:popup:chromium; wait",
    "serve:popup:chromium": "vite build --watch --config vite.popup.config.ts",
    "serve:manual-test": "node scripts/serve-manual-test.mjs",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "tune:detector": "node --no-warnings --experimental-strip-types scripts/evaluate-detector-fixtures.mjs",
    "lint": "eslint ./src/",
    "verify:weekly-scorecard": "node --no-warnings --experimental-strip-types scripts/verify-weekly-scorecard.mjs",
    "verify:chromium": "node scripts/verify-chromium-build.mjs"
  },
  "sideEffects": [
    "./src/{content,popup,background,options,local-file-player}/main.ts",
    "./src/content/SilenceDetector/SilenceDetectorProcessor.ts",
    "./src/content/VolumeFilter/VolumeFilterProcessor.ts"
  ],
  "dependencies": {
    "hh-mm-ss": "^1.2.0",
    "lodash": "^4.17.21",
    "tippy.js": "^6.3.7",
    "tone": "~14.7.77"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.4.0",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@types/chrome": "^0.1.18",
    "@types/firefox-webext-browser": "^120.0.5",
    "@types/hh-mm-ss": "^1.2.3",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.1",
    "eslint": "^8.44.0",
    "minimize-webext-i18n-json": "^2.0.2",
    "style-loader": "^4.0.0",
    "svelte": "^5",
    "svelte-check": "^3.7.1",
    "svelte-loader": "^3.2.0",
    "svelte-preprocess": "^5.1.4",
    "tinybench": "^2.9.0",
    "ts-loader": "^9.5.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "webpack": "^5.91.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1"
  }
}
